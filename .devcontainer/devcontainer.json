{
    // ─────────────────────────────────────────────────────────────────────────
    // Dev Container — Flutter Android + Web (GitHub Codespaces)
    // Flutter 3.47.7 · Dart 3.13.5 · Java 21 · Android SDK 36
    // NDK 28.2.13676358 · CMake 3.22.1 · Node 22 · Chrome (web tests)
    // ─────────────────────────────────────────────────────────────────────────
    "name": "Flutter Android + Web",

    // ── Build ─────────────────────────────────────────────────────────────────
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    // ── Codespaces user (injected automatically by GitHub) ────────────────────
    "remoteUser": "vscode",

    // ── Environment variables available in every terminal and process ─────────
    "remoteEnv": {
        "FLUTTER_HOME": "/opt/flutter",
        "ANDROID_HOME": "/opt/android-sdk",
        "ANDROID_SDK_ROOT": "/opt/android-sdk",
        "ANDROID_NDK_HOME": "/opt/android-sdk/ndk/28.2.13676358",
        "ANDROID_NDK_ROOT": "/opt/android-sdk/ndk/28.2.13676358",
        "PUB_CACHE": "/opt/pub-cache",
        "CCACHE_DIR": "/home/vscode/.ccache",
        "GRADLE_USER_HOME": "/home/vscode/.gradle",
        "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64",
        "CHROME_EXECUTABLE": "/usr/bin/google-chrome-stable",
        "FLUTTER_SUPPRESS_ANALYTICS": "true",
        "DART_SUPPRESS_ANALYTICS": "true",
        // Extend the container PATH (Flutter, Dart, pub global bins, Android, ccache)
        "PATH": "/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:/opt/pub-cache/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/36.0.0:/usr/lib/jvm/java-21-openjdk-amd64/bin:/usr/lib/ccache:${containerEnv:PATH}"
    },

    // ── Persistent cache volumes ───────────────────────────────────────────────
    // Named volumes survive container rebuilds, preventing full re-downloads of
    // Gradle deps, Dart packages, and ccache data on every `gh cs rebuild`.
    // Do not rename these volume sources without intentionally resetting caches.
    "mounts": [
        // Gradle distribution + dependency cache (~1-3 GB after first build)
        {
            "source": "musicplayer-gradle-cache",
            "target": "/home/vscode/.gradle",
            "type": "volume"
        },
        // ccache compiled-object cache (speeds up NDK/C++ rebuilds)
        {
            "source": "musicplayer-ccache",
            "target": "/home/vscode/.ccache",
            "type": "volume"
        },
        // Dart/Flutter pub cache (avoids re-downloading packages on rebuild)
        {
            "source": "musicplayer-pub-cache",
            "target": "/opt/pub-cache",
            "type": "volume"
        }
    ],

    // ── Post-creation setup ────────────────────────────────────────────────────
    // Runs once after the container is created (not on every start).
    "postCreateCommand": "bash .devcontainer/postCreate.sh",

    // ── VS Code customizations ────────────────────────────────────────────────
    "customizations": {
        "vscode": {
            "extensions": [
                // Flutter / Dart
                "Dart-Code.flutter",
                "Dart-Code.dart-code",
                // Kotlin / Java / Gradle
                "fwcd.kotlin",
                "vscjava.vscode-gradle",
                // C/C++ (JNI / native DSP)
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                // CMake / Make
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "ms-vscode.makefile-tools",
                // Shell / YAML / Markdown / JSON
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "redhat.vscode-yaml",
                "DavidAnson.vscode-markdownlint",
                "esbenp.prettier-vscode",
                // General helpers
                "streetsidesoftware.code-spell-checker",
                "EditorConfig.EditorConfig"
            ],
            "settings": {
                // Flutter & Dart SDK paths
                "dart.flutterSdkPath": "/opt/flutter",
                "dart.sdkPath": "/opt/flutter/bin/cache/dart-sdk",
                "dart.analysisExcludedFolders": [
                    "build",
                    ".dart_tool",
                    "native_audio_runtime/example"
                ],

                // Java
                "java.home": "/usr/lib/jvm/java-21-openjdk-amd64",

                // Android SDK
                "android.sdk.path": "/opt/android-sdk",

                // CMake
                "cmake.configureOnOpen": false,

                // Shell
                "shellcheck.executablePath": "/usr/bin/shellcheck",

                // Editor
                "editor.formatOnSave": true,
                "editor.rulers": [100],
                "files.trimTrailingWhitespace": true,
                "files.trimFinalNewlines": true,

                // C/C++ IntelliSense (points at NDK clang headers)
                "C_Cpp.default.compilerPath": "/opt/android-sdk/ndk/28.2.13676358/toolchains/llvm/prebuilt/linux-x86_64/bin/clang",
                "C_Cpp.default.cStandard": "c11",
                "C_Cpp.default.cppStandard": "c++17"
            }
        }
    },

    // ── Codespaces-specific settings ──────────────────────────────────────────
    "features": {},

    // Forwarded on demand by Codespaces; these are the two local dev servers.
    "forwardPorts": [5000, 8080],
    "portsAttributes": {
        "5000": {
            "label": "Music Player web (server.js)",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "Flutter web debug",
            "onAutoForward": "notify"
        }
    },

    // Reasonable machine size for Android/NDK builds
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    }
}
