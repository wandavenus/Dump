modules = ["nodejs-20", "java-graalvm22.3", "python-3.12"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watch & Rebuild Web"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Watch & Rebuild Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node watch-rebuild.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Flutter Analyze"
mode = "sequential"
author = 61865488

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flutter analyze"

[[ports]]
localPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
build = ["bash", "-c", "flutter build web --release --base-href /"]
