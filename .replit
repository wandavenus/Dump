modules = ["nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watch & Rebuild Web"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Watch & Rebuild Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && node watch-rebuild.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Flutter Analyze"
mode = "sequential"
author = 61865488

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && export PATH=\"/home/runner/flutter/bin:$PATH\" && flutter analyze"

[[workflows.workflow]]
name = "Rebuild Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && node rebuild-web.js"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
build = ["bash", "-c", "bash setup-flutter.sh && export PATH=\"/home/runner/flutter/bin:$PATH\" && flutter build web --release --base-href /"]
