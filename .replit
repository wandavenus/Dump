modules = ["nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Watch & Rebuild Web"


[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[workflows.workflow]]
name = "Watch & Rebuild Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && export PATH=\"/home/runner/workspace/flutter-ws/flutter/bin:$PATH\" && node watch-rebuild.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Flutter Analyze"
mode = "sequential"
author = 61865488

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && export PATH=\"/home/runner/workspace/flutter-ws/flutter/bin:$PATH\" && flutter analyze lib test"

[[workflows.workflow]]
name = "Rebuild Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && export PATH=\"/home/runner/workspace/flutter-ws/flutter/bin:$PATH\" && node rebuild-web.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Build APK"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && bash build-apk.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Flutter Debug Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup-flutter.sh && export PATH=\"/home/runner/workspace/flutter-ws/flutter/bin:$PATH\" && flutter run -d web-server --web-hostname 0.0.0.0 --web-port 5173"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Flutter DevTools"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PATH=\"/home/runner/workspace/flutter-ws/flutter/bin:$PATH\" && dart devtools --no-launch-browser --host 0.0.0.0 --port 9100"
waitForPort = 9100

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 9100
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
build = ["bash", "-c", "bash setup-flutter.sh && export PATH=\"/home/runner/workspace/flutter-ws/flutter/bin:$PATH\" && flutter build web --release --base-href /"]
